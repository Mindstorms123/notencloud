# ----------------------------------------------------------------------
# Notencloud Web PWA - Apache Configuration für Shared Webhosting
# ----------------------------------------------------------------------

# 1. Korrekte MIME-Types für Flutter Web (insb. WebAssembly & Manifests)
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/javascript .js
    AddType application/json .json
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/ttf .ttf
</IfModule>

# 2. GZIP-Komprimierung aktivieren (spart Bandbreite & beschleunigt Ladezeit)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm font/woff2
</IfModule>

# 3. Cache-Steuerung:
# - HTML, Manifest und Service-Worker NIE cachen (damit Musiker Updates sofort sehen)
<FilesMatch "\.(html|json)$">
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

<FilesMatch "flutter_service_worker\.js">
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </IfModule>
</FilesMatch>

# - Statische Assets (JS, WASM, Fonts, Bilder) dürfen im Cache bleiben
<FilesMatch "\.(js|wasm|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=2592000, public"
    </IfModule>
</FilesMatch>

# 4. Fallback-Routing für Single-Page-Apps
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
